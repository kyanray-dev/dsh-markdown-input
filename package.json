{
  "name": "dsh-markdown-input",
  "version": "1.0.0",
  "description": "Markdown list continuation and syntax hints for the DSH composer.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Kyan <kyanrayg@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyanray-dev/dsh-markdown-input.git"
  },
  "homepage": "https://github.com/kyanray-dev/dsh-markdown-input#readme",
  "bugs": "https://github.com/kyanray-dev/dsh-markdown-input/issues",
  "keywords": ["dsh", "dsh-plugin", "markdown", "composer", "list"],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
