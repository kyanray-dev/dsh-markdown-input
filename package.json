{
  "name": "dsh-markdown-input",
  "version": "1.1.0",
  "description": "Markdown input for the DSH composer: list continuation, list and task glyphs, inline formatting, fenced code highlighting.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Kyan <kyanrayg@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyanray-dev/dsh-markdown-input.git"
  },
  "homepage": "https://github.com/kyanray-dev/dsh-markdown-input#readme",
  "bugs": "https://github.com/kyanray-dev/dsh-markdown-input/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "markdown",
    "composer",
    "list",
    "syntax-highlighting"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
